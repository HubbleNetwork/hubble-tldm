# This file is the application Kconfig entry point. All application Kconfig
# options can be defined here or included via other application Kconfig files.
# You can browse these options using the west targets menuconfig (terminal) or
# guiconfig (GUI).

config APP_SAT_TX_INTERVAL_SECONDS
	int "Inter-transmission sleep in seconds"
	default 10
	help
	  Time the application sleeps between consecutive satellite packet
	  transmissions, in seconds.

	  Because packets are sent with HUBBLE_SAT_RELIABILITY_NONE, the send
	  call does not block on a retry sequence, so this is also the
	  effective packet rate. At the default of 10 a board transmits about
	  8,600 packets a day; raise it to put less traffic on the network.

menu "Zephyr"
source "Kconfig.zephyr"
endmenu

module = APP
module-str = APP
source "subsys/logging/Kconfig.template.log_config"
