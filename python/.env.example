# Copy this to `.env` (in this directory or the repo root) and fill in
# real values. `.env` is gitignored. Loaded by tests/conftest.py via
# python-dotenv; existing shell env always wins.

# ---- Required for hubbledemo flash + pyhubblenetwork ----
HUBBLE_ORG_ID=
HUBBLE_API_TOKEN=

# ---- Required to actually run the e2e test ----
# Any board ID from merge/md.json (e.g. nrf52dk, nrf52840dk, nrf21540dk,
# nrf54l15dk, bg22_ek4108a, lp_em_cc2340r5, lp_em_cc2340r53). If unset,
# tests/test_e2e.py is skipped.
HUBBLE_TEST_BOARD=

# ---- Optional: test a locally-built ELF instead of merge/<board>.elf ----
# Forwarded to hubbledemo flash as HUBBLE_DEMO_ELF_FILE.
#HUBBLE_TEST_ELF_FILE=../firmware/zephyr/hubble-demo-app/build/zephyr/zephyr.elf

# ---- Optional tunables (defaults shown) ----
#HUBBLE_TEST_SCAN_TIMEOUT=90
#HUBBLE_TEST_SCAN_COUNT=3
#HUBBLE_TEST_INGEST_WAIT=45
#HUBBLE_TEST_DEVICE_NAME=
